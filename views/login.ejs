<%- include('partials/header') %>

<h1>Login</h1>

<form action="/login" method="POST" style="max-width: 400px;">
    <div style="margin-bottom: 15px;">
        <label for="username">Username:</label><br>
        <input type="text" id="username" name="username" required style="width: 100%; padding: 8px;">
    </div>

    <div style="margin-bottom: 15px;">
        <label for="password">Password:</label><br>
        <input type="password" id="password" name="password" required style="width: 100%; padding: 8px;">
    </div>

    <button type="submit" style="padding: 10px 15px; background-color: #333; color: white; border: none; cursor: pointer;">Login</button>
</form>

<p style="margin-top: 15px;">Don't have an account? <a href="/register">Register here</a></p>

<%- include('partials/footer') %>
