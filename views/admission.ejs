<%- include('partials/header') %>

<h1>Admission Form</h1>
<p>Apply for admission for the upcoming academic year.</p>

<form action="/admission" method="POST" style="max-width: 500px;">
    <div style="margin-bottom: 15px;">
        <label for="name">Student Full Name:</label><br>
        <input type="text" id="name" name="name" required style="width: 100%; padding: 8px;">
    </div>

    <div style="margin-bottom: 15px;">
        <label for="email">Parent/Guardian Email:</label><br>
        <input type="email" id="email" name="email" required style="width: 100%; padding: 8px;">
    </div>

    <div style="margin-bottom: 15px;">
        <label for="phone">Phone Number:</label><br>
        <input type="text" id="phone" name="phone" required style="width: 100%; padding: 8px;">
    </div>

    <button type="submit" style="padding: 10px 15px; background-color: #333; color: white; border: none; cursor: pointer;">Submit Application</button>
</form>

<%- include('partials/footer') %>
